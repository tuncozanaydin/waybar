{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 4,

  "modules-left": ["custom/help", "custom/launcher", "hyprland/workspaces", "hyprland/window"],
  "modules-center": ["custom/clock"],
  "modules-right": ["cpu", "memory", "custom/gpu", "pulseaudio", "bluetooth", "custom/vpn", "network", "tray", "custom/power"],

  "custom/help": {
    "format": "\uf059",
    "tooltip-format": "Show key bindings (Super + F1)",
    "on-click": "pkill -x fuzzel || ~/.config/hypr/scripts/keybinds.py"
  },

  "custom/launcher": {
    "format": "\uf17c",
    "tooltip": false,
    "on-click": "fuzzel"
  },

  "hyprland/workspaces": {
    "format": "{id}",
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "on-scroll-down": "hyprctl dispatch workspace e+1",
    "persistent-workspaces": { "*": 5 }
  },

  "hyprland/window": {
    "max-length": 60,
    "separate-outputs": true
  },

  "custom/clock": {
    "exec": "~/.config/waybar/clock.sh",
    "return-type": "json",
    "interval": 5
  },

  "cpu": {
    "format": "CPU {usage:>3}%",
    "interval": 5
  },

  "memory": {
    "format": "MEM {used:>4.1f}G",
    "tooltip-format": "RAM {used:0.1f} / {total:0.1f} GiB ({percentage}%)\nSwap {swapUsed:0.1f} / {swapTotal:0.1f} GiB",
    "interval": 5
  },

  "custom/gpu": {
    "exec": "~/.config/waybar/gpu.sh",
    "return-type": "json",
    "interval": 5,
    "on-click": "kitty -e nvtop"
  },

  "pulseaudio": {
    "format": "{icon} {volume:>3}%",
    "format-muted": "\uf026 mute",
    "format-icons": { "default": ["\uf026", "\uf027", "\uf028"] },
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 5
  },

  "bluetooth": {
    "format": "\uf293",
    "format-off": "\uf293 off",
    "format-disabled": "",
    "format-connected": "\uf293",
    "format-connected-battery": "\uf293 {device_battery_percentage:>3}%",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_battery_percentage}%",
    "on-click": "blueman-manager",
    "on-click-right": "bluetoothctl power $(bluetoothctl show | grep -q 'Powered: yes' && echo off || echo on)"
  },

  "custom/vpn": {
    "exec": "~/.config/waybar/vpn.sh",
    "return-type": "json",
    "interval": 10,
    "signal": 8,
    "on-click": "~/.local/bin/vpn toggle"
  },

  "network": {
    "format-wifi": "\uf1eb {essid}",
    "format-ethernet": "\uf0e8 {ipaddr}",
    "format-disconnected": "⚠ offline",
    "tooltip-format": "{ifname} {ipaddr}/{cidr} via {gwaddr}",
    "on-click": "nm-connection-editor"
  },

  "tray": {
    "spacing": 8
  },

  "custom/power": {
    "format": "\uf011",
    "tooltip-format": "Left: lock  |  Right: power menu",
    "on-click": "hyprlock",
    "on-click-right": "~/.config/waybar/power-menu.sh"
  }
}
